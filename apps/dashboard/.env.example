# Browser + server: call Cloudflare Worker API directly
NEXT_PUBLIC_API_URL=https://trainfabric-router.rishabhspro.workers.dev

# Optional same-origin proxy upstream (local /api/proxy only)
API_UPSTREAM=https://trainfabric-router.rishabhspro.workers.dev

# Clerk — required to gate the dashboard (home, datasets, agents, publish).
# Marketing `/` and `/docs` stay public. Without these keys, dashboard auth is open
# (local/CI builds) and a warning banner is shown.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/home
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/home
