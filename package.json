{
  "name": "trainfabric",
  "private": true,
  "version": "0.1.0",
  "description": "Agent-native data lakehouse — Iceberg on R2, DuckDB compute, Cloudflare Workers",
  "packageManager": "pnpm@10.29.3",
  "scripts": {
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "test:shared": "pnpm --filter @trainfabric/shared test",
    "test:router": "pnpm --filter @trainfabric/router test",
    "test:compute": "cd services/compute && python -m pytest -q",
    "lint": "pnpm -r run lint --if-present",
    "dev:dashboard": "pnpm --filter @trainfabric/dashboard dev",
    "dev:router": "pnpm --filter @trainfabric/router dev",
    "box:golden": "node scripts/box-golden-bootstrap.mjs",
    "typecheck": "pnpm -r run typecheck --if-present"
  },
  "devDependencies": {
    "typescript": "^5.8.2",
    "vitest": "^3.0.9"
  },
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd",
      "sharp",
      "@clerk/shared"
    ]
  }
}