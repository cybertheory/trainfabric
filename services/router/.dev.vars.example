# Router Worker
CONVEX_URL=https://YOUR.convex.site
CONVEX_SERVICE_KEY=dev-service-key
COMPUTE_URL=http://127.0.0.1:8080
CLERK_JWT_ISSUER=https://desired-seal-5.clerk.accounts.dev
# Leave CLERK_JWT_AUDIENCE unset for default Clerk session tokens (dashboard getToken()).
# Set to "convex" only when verifying Convex JWT template tokens.
PUBLIC_API_BASE=https://trainfabric-router.rishabhspro.workers.dev
# AGENT_TOKEN_SECRET=  # wrangler secret put AGENT_TOKEN_SECRET

# Autoresearch /auto — Box sandboxes + Modal GPU trials.
# Without BOX_API_KEY the router runs /auto in stub mode (control plane only).
BOX_API_KEY=
BOX_TEMPLATE_ID=
BOX_API_BASE=https://ascii.dev/api/box/v1
MODAL_TOKEN=
MODAL_APP_REF=
# MODAL_API_BASE=  # optional override for Modal trial endpoint

# GitHub App (install + user OAuth during installation)
# Callback: ${PUBLIC_API_BASE}/github/callback
# Webhook:  ${PUBLIC_API_BASE}/github/webhook
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_WEBHOOK_SECRET=
GITHUB_APP_STATE_SECRET=
GITHUB_TOKEN_CRYPTO_KEY=
# DASHBOARD_URL=http://localhost:3000
