ICEBERG_CATALOG_URI=postgresql://user:pass@localhost:5432/iceberg
# For local tests: sqlite:////tmp/iceberg_catalog.db
ICEBERG_WAREHOUSE=s3://trainfabric-data/warehouse
CATALOG_BACKEND=sql
ENABLE_BRANCHING=false
R2_ENDPOINT=https://ACCOUNT.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=trainfabric-data
R2_REGION=auto
DATABASE_URL=postgresql://user:pass@localhost:5432/iceberg
STREAM_SIZE_THRESHOLD_BYTES=52428800
MAX_RESULT_ROWS=10000000

# Cloudflare AI Gateway (Hermes NL → DuckDB)
CF_ACCOUNT_ID=
CF_AI_GATEWAY_ID=trainfabric
CF_AI_GATEWAY_TOKEN=
# Optional override; default uses api.cloudflare.com/.../ai/v1
# CF_AI_GATEWAY_BASE=https://api.cloudflare.com/client/v4/accounts/$CF_ACCOUNT_ID/ai/v1
CF_AI_MODEL=@cf/meta/llama-3.1-8b-instruct
